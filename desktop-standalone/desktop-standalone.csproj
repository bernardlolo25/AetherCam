<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Identity -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AetherCam.Desktop</RootNamespace>
    <AssemblyName>AetherCam</AssemblyName>
    <Product>AetherCam Studio</Product>
    <Version>2.1.0</Version>
    <Copyright>AetherCam Open Source Project</Copyright>

    <!-- Compile settings -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>

    <!-- Single-file self-contained publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Windows-specific: embed app icon + set subsystem -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Embed the React UI dist folder so it's available at runtime -->
  <ItemGroup>
    <Content Include="wwwroot\dist\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <!-- QR code generation for pairing screen -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- JSON serialization -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
</Project>
